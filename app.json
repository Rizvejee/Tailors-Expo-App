{
  "expo": {
    "name": "Tailors",
    "slug": "Tailors",
    "scheme": "tailors",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
  "expo-router",
  [
    "expo-splash-screen",
    {
      "backgroundColor": "#1B4332",
      "image": "./assets/icon.png",
      "imageWidth": 100
    }
  ]
],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1B4332"
      },
      "package": "com.rizwan.tailors",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "645fbfb5-9f6f-4dea-ba39-16191763746c"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/645fbfb5-9f6f-4dea-ba39-16191763746c"
    }
  }
}
